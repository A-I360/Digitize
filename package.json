{
  "name": "synq-technological-services",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-page site for SYNQ Technological Services, including the original 2D platformer Aether Drift.",
  "type": "module",
  "scripts": {
    "start": "node server/site-server.js",
    "build": "node tools/build-levels.mjs && node tools/build-sitemap.mjs",
    "multiplayer": "npm --prefix server run multiplayer",
    "test": "node tests/run.mjs",
    "test:levels": "node tests/level-playthrough.mjs",
    "test:contrast": "node tests/contrast.mjs",
    "test:dom": "node tests/dom-smoke.mjs",
    "test:ui": "node tests/game-ui.mjs",
    "test:online": "node tests/online-lobby.mjs",
    "test:site-ui": "node tests/site-ui.mjs",
    "test:a11y": "node tests/a11y.mjs",
    "test:transitions": "node tests/transitions.mjs",
    "test:device": "node tests/device.mjs",
    "test:perf": "node tests/performance.mjs",
    "test:multiplayer": "node tests/multiplayer.mjs",
    "test:site": "node tests/site.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
